modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev & PORT=21078 BASE_PATH=/ pnpm --filter @workspace/rundinova run dev"
waitForPort = 21078

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 5173

[[ports]]
localPort = 8084
externalPort = 6800

[[ports]]
localPort = 21078
externalPort = 3000

[[ports]]
localPort = 21079
externalPort = 3002

[[ports]]
localPort = 21080
externalPort = 3003

[[ports]]
localPort = 21081
externalPort = 4200

[[ports]]
localPort = 21082
externalPort = 5000

[[ports]]
localPort = 21083
externalPort = 6000

[[ports]]
localPort = 21084
externalPort = 8000

[[ports]]
localPort = 21085
externalPort = 8008
